sdcpp/*.exe
sdcpp/*.dll

# Generated outputs (timestamped)
images/

# App log (server stdout is piped here at DEBUG)
app.log

# User-local settings (auto-created by the app on first switch change)
settings.ini

# PyInstaller build artifacts
build/
dist/
*.spec
